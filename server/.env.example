# Digital Susu V2 API — environment configuration
#
# Copy to .env and fill in real values. NEVER commit .env (spec §26).
# All values shown here are examples/dev defaults.

# Node environment: development | test | production
NODE_ENV=development

# HTTP port
PORT=8080

# PostgreSQL connection string.
# Leave unset to run in in-memory mode (development/tests only).
DATABASE_URL=postgres://digital_susu:change-me@localhost:5432/digital_susu

# JWT secrets — generate strong random values in production:
#   openssl rand -base64 48
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret

# Token lifetimes
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Password hashing cost (bcrypt rounds)
BCRYPT_ROUNDS=10

# CORS origins (comma-separated) for future web clients
CORS_ORIGINS=http://localhost:3000

# Rate limiting (requests per window per IP)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
