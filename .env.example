# Digital Susu V2 — environment configuration example.
#
# Values are passed at build/run time via --dart-define, e.g.:
#   flutter run --dart-define=USE_MOCK_DATA=true
#
# Copy to .env only for documentation purposes; the app reads dart-define
# values through AppEnvironment (lib/core/config/environment.dart), not this
# file directly.

# When true, repositories serve mock data so the UI can be developed without
# a backend. When false, the app calls the real API.
USE_MOCK_DATA=true

# Base URL of the backend API (used when USE_MOCK_DATA=false).
API_BASE_URL=https://api.digitalsusu.example.com/v1

# Enable verbose network/logging output in debug builds.
DEBUG_LOGGING=false
